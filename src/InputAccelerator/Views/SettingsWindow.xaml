<Window
    x:Class="InputAccelerator.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:InputAccelerator.ViewModels">

    <Grid
        x:Name="RootGrid"
        MinWidth="440"
        MinHeight="320"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid
            Margin="20"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="2">
                <TextBlock x:Uid="SettingsHeader" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="SettingsSubheader" Style="{StaticResource HintTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock x:Uid="DisplayModeLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox
                    x:Uid="DisplayModeCombo"
                    MinWidth="180"
                    HorizontalAlignment="Left"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="DisplayModeSystem" />
                    <ComboBoxItem x:Uid="DisplayModeLight" />
                    <ComboBoxItem x:Uid="DisplayModeDark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock x:Uid="FloatingBackgroundLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <GridView
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.BackgroundOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedBackgroundOption, Mode=TwoWay}"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Width" Value="32" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="0,0,2,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="16" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="ToolTipService.ToolTip" Value="{Binding Label}" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FloatingBackgroundOption">
                            <Border
                                Width="24"
                                Height="24"
                                AutomationProperties.Name="{x:Bind Label}"
                                Background="{x:Bind PreviewBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                ToolTipService.ToolTip="{x:Bind Label}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock x:Uid="FloatingBackgroundHint" Style="{StaticResource HintTextStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
