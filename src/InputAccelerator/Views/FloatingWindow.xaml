<Window
    x:Class="InputAccelerator.Views.FloatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:InputAccelerator.Helpers"
    xmlns:vm="using:InputAccelerator.ViewModels">

    <Grid
        x:Name="RootGrid"
        MinWidth="0"
        MinHeight="0"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Border
            x:Name="WindowBorder"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid x:Name="ExpandedView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border
                            x:Name="DragHandle"
                            Background="Transparent"
                            PointerCaptureLost="OnDragHandlePointerCaptureLost"
                            PointerMoved="OnDragHandlePointerMoved"
                            PointerPressed="OnDragHandlePointerPressed"
                            PointerReleased="OnDragHandlePointerReleased">
                            <Border
                                x:Name="DragIndicator"
                                Width="24"
                                Height="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                CornerRadius="1.5"
                                Opacity="0.6" />
                        </Border>

                        <Button
                            x:Name="CollapseButton"
                            Width="20"
                            Height="20"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnCollapseClick"
                            Style="{StaticResource FloatingIconButtonStyle}">
                            <FontIcon
                                x:Name="CollapseIcon"
                                FontSize="10"
                                Foreground="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                Glyph="&#xE921;" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer
                            Padding="6,0,6,4"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto">
                            <ItemsControl x:Name="ChipHost" Background="Transparent">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FloatingEntryItemViewModel">
                                        <Button
                                            MaxWidth="220"
                                            AutomationProperties.Name="{x:Bind Preview, Mode=OneWay}"
                                            Background="{x:Bind ChipBackground, Mode=OneWay}"
                                            BorderBrush="{x:Bind ChipBorder, Mode=OneWay}"
                                            Click="OnEntryClick"
                                            Style="{StaticResource FloatingChipButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind Entry.Content, Mode=OneWay}">
                                            <TextBlock
                                                Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                                                Text="{x:Bind Preview, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock
                            x:Name="EmptyStateText"
                            x:Uid="FloatingEmpty"
                            Margin="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>

                <Button
                    x:Name="CollapsedBlock"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="0"
                    Click="OnRestoreClick"
                    CornerRadius="8"
                    Style="{StaticResource FloatingChipButtonStyle}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CollapsedIcon"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="字" />
                </Button>
            </Grid>
        </Border>

        <Grid
            x:Name="ResizeGrip"
            Width="18"
            Height="18"
            Margin="0,0,2,2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            PointerCaptureLost="OnResizeGripPointerCaptureLost"
            PointerMoved="OnResizeGripPointerMoved"
            PointerPressed="OnResizeGripPointerPressed"
            PointerReleased="OnResizeGripPointerReleased">
            <Path
                x:Name="ResizeGripPath"
                Width="9"
                Height="9"
                Margin="0,0,3,3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Data="M0,9 L9,0 M3,9 L9,3 M6,9 L9,6"
                Opacity="0.6"
                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                StrokeThickness="1" />
        </Grid>
    </Grid>
</Window>
